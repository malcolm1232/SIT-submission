{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://sit-design-review.invalid/harness/scores.schema.json",
 "title": "sit-eval scores.json (one review scored against one answer key)",
 "type": "object",
 "required": ["schema_version", "kind", "generated_at", "status", "exploratory", "inputs", "prereg", "prompts", "judge",
              "metrics", "warnings", "calls"],
 "properties": {
  "schema_version": {"const": "1.0"},
  "kind": {"const": "sit_eval.scores"},
  "generated_at": {"type": "string"},
  "exploratory": {"type": "boolean",
                  "description": "LC12 (eval/prereg.yaml): true when the run was started with --exploratory (the only way to score a key whose scored_run_ready is false); such scores may not be reported as confirmatory"},
  "exploratory_note": {"type": ["string", "null"], "description": "the human-readable exploratory line; null for a confirmatory run"},
  "outside_preregistered_analysis": {"type": "boolean", "description": "true when eval/prereg.yaml was frozen and the run was --exploratory"},
  "status": {"enum": ["frozen", "pilot_unfrozen", "plumbing_only", "stopped_budget"],
             "description": "plumbing_only = fake judge; stopped_budget = --max-cost-usd reached, metrics empty"},
  "inputs": {
   "type": "object",
   "required": ["report_path", "report_sha256", "review_id", "run_id", "condition", "key_path", "key_sha256", "item_id",
                "scored_run_ready", "doc_version", "doc_source", "doc_sha256_text", "doc_sha256_text_matches_review"],
   "properties": {
    "report_sha256": {"$ref": "#/$defs/Sha256"},
    "key_sha256": {"$ref": "#/$defs/Sha256"},
    "doc_sha256_text": {"$ref": "#/$defs/Sha256"},
    "doc_version": {"enum": ["v1", "v2"]},
    "condition": {"type": ["string", "null"]},
    "verdict_label": {"enum": ["fit", "fit_with_conditions", "not_fit", "not_assessed", null],
                      "description": "the review's verdict label; not_assessed = the agent run produced no assessment (scored intention-to-treat, flagged in warnings)"},
    "scored_run_ready": {"type": "boolean"},
    "doc_sha256_text_matches_review": {"type": ["boolean", "null"]}
   }
  },
  "prereg": {"type": "object", "required": ["frozen", "label", "message"],
             "properties": {"frozen": {"type": "boolean"}, "label": {"enum": ["frozen", "pilot_unfrozen", "refused"]},
                            "message": {"type": "string"}}},
  "prompts": {"type": "object", "required": ["bundle_sha256", "lock_ok", "problems"],
              "properties": {"bundle_sha256": {"$ref": "#/$defs/Sha256"}, "lock_ok": {"type": "boolean"},
                             "problems": {"type": "array", "items": {"type": "string"}}}},
  "judge": {"type": "object", "required": ["judge_kind", "model", "effort", "samples", "seed", "granularity",
                                           "grounding_judges"],
            "properties": {"judge_kind": {"enum": ["fake", "claude_code", "anthropic_api"]},
                           "granularity": {"enum": ["pairwise", "per_flaw_batch"]},
                           "samples": {"type": "integer", "minimum": 1}, "seed": {"type": "integer"}}},
  "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Metric"}},
  "warnings": {"type": "array", "items": {"type": "string"}},
  "calls": {"type": "object", "required": ["calls_total", "calls_live", "calls_cached", "calls_failed", "budget"],
            "properties": {"calls_total": {"type": "integer", "minimum": 0},
                           "calls_live": {"type": "integer", "minimum": 0},
                           "calls_cached": {"type": "integer", "minimum": 0},
                           "calls_failed": {"type": "integer", "minimum": 0},
                           "budget": {"type": "object", "required": ["stopped"],
                                      "properties": {"stopped": {"type": "boolean"}}}}},
  "findings": {"type": "array", "items": {"type": "object",
               "required": ["finding_id", "rank", "matched_flaw_strict", "matched_flaw_lenient", "class_strict"],
               "properties": {"finding_id": {"type": "string"},
                              "class_strict": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/AdjClass"}]},
                              "class_lenient": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/AdjClass"}]}}}},
  "flaws": {"type": "array", "items": {"type": "object", "required": ["flaw_id", "severity", "matched_finding_strict",
                                                                      "matched_finding_lenient"]}},
  "matching": {"type": "object", "required": ["granularity", "candidates", "shortlist", "pair_scores", "strict",
                                              "lenient"],
               "properties": {
                "candidate_rule": {"enum": ["shortlist_bounded", "union"]},
                "pair_scores": {"type": "array", "items": {"type": "object",
                  "required": ["finding_id", "flaw_id", "sources", "samples", "median"],
                  "properties": {"samples": {"type": "array", "items": {"enum": [0, 1, 2, 3, null]}},
                                 "median": {"type": ["number", "null"], "minimum": 0, "maximum": 3},
                                 "sources": {"type": "array", "items": {"enum": ["overlap", "shortlist"]}}}}},
                "strict": {"$ref": "#/$defs/Pairs"}, "lenient": {"$ref": "#/$defs/Pairs"}}},
  "adjudication": {"type": "object", "required": ["strict", "lenient"],
                   "properties": {"strict": {"$ref": "#/$defs/AdjRows"}, "lenient": {"$ref": "#/$defs/AdjRows"}}},
  "grounding": {"type": "object", "required": ["quotes", "provenance", "premise", "citation"]},
  "human_review_queue": {"type": "object"},
  "failures": {"type": "array", "items": {"type": "string"}},
  "stop": {"type": "object"},
  "elapsed_s": {"type": "number"}
 },
 "allOf": [
  {"if": {"properties": {"exploratory": {"const": true}}, "required": ["exploratory"]},
   "then": {"required": ["exploratory_note"], "properties": {"exploratory_note": {"type": "string"}}}},
  {"if": {"properties": {"status": {"not": {"const": "stopped_budget"}}}},
   "then": {"required": ["findings", "flaws", "matching", "adjudication", "grounding", "failures"],
            "properties": {"metrics": {"required": ["recall", "precision_strict", "precision_adjudicated",
                                                    "lenient_recall", "severity_weighted_recall",
                                                    "hallucinated_finding_rate", "cdr", "efficiency"]}}},
   "else": {"required": ["stop"]}}
 ],
 "$defs": {
  "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "AdjClass": {"enum": ["DUPLICATE", "VALID_UNPLANTED", "PARTIAL_KEY_MATCH", "HALLUCINATED", "NON_SPECIFIC",
                        "INVALID_OPINION", "OUT_OF_SCOPE", "UNADJUDICATED"],
               "description": "PARTIAL_KEY_MATCH is assigned by the harness (strict-unmatched, median 2 against a key flaw nobody matched; UD #14), never by the LLM adjudicator"},
  "Metric": {
   "type": "object", "required": ["value", "reason", "status"],
   "properties": {
    "reason": {"type": ["string", "null"]},
    "status": {"enum": ["primary", "key_secondary", "secondary", "exploratory", "deferred", "blocked"]}
   },
   "if": {"properties": {"value": {"type": "null"}}},
   "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
  },
  "Pairs": {"type": "array", "items": {"type": "object", "required": ["finding_id", "flaw_id", "score"],
            "properties": {"score": {"type": "number", "minimum": 2, "maximum": 3}}}},
  "AdjRows": {"type": "array", "items": {"type": "object", "required": ["finding_id", "class", "basis"],
              "properties": {"class": {"$ref": "#/$defs/AdjClass"},
                             "basis": {"enum": ["llm", "deterministic_duplicate", "deterministic_partial",
                                                "still_valid_observation", "llm_failed"]}},
              "if": {"properties": {"class": {"const": "PARTIAL_KEY_MATCH"}}},
              "then": {"required": ["partial_key_flaw_id"],
                       "properties": {"partial_key_flaw_id": {"type": "string"},
                                      "basis": {"const": "deterministic_partial"}}}}}
 }
}
