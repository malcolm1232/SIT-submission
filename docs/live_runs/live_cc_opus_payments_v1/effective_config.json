 "criteria": {
  "criteria": [
   {
    "applies_to": [
     "all"
    ],
    "id": "design_intent",
    "kinds": [
     "strength",
     "gap",
     "ambiguity"
    ],
    "lab_ref": "§1.2, §2.1, §2.3",
    "question": "What are the design's objectives, principles, constraints, requirements and approved decisions, and are they stated clearly enough to review against?",
    "research_hints": []
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "fitness_for_objectives",
    "kinds": [
     "strength",
     "risk",
     "gap",
     "validation_need"
    ],
    "lab_ref": "§1.4, §2.3, §3.2",
    "question": "Does each major design element plausibly achieve the objective or requirement it is meant to serve?",
    "research_hints": [
     "capabilities and documented limits of the named products and services"
    ]
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "requirement_completeness",
    "kinds": [
     "gap"
    ],
    "lab_ref": "§1.4, §2.3",
    "question": "Are any requirements, controls, error paths, rollback paths or owners missing that the objectives need?",
    "research_hints": []
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "internal_consistency",
    "kinds": [
     "risk",
     "ambiguity"
    ],
    "lab_ref": "§2.4",
    "question": "Do requirements, decisions, numbers, flows and acceptance criteria agree with each other across sections?",
    "research_hints": []
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "claims_and_external_constraints",
    "kinds": [
     "risk",
     "validation_need"
    ],
    "lab_ref": "§1.2, §3.2",
    "question": "Are factual and quantitative claims about products, standards, regulations and platform limits correct and current?",
    "research_hints": [
     "official product documentation and published quotas",
     "the text of the cited standard or regulation"
    ]
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "security_and_privacy",
    "kinds": [
     "risk",
     "gap"
    ],
    "lab_ref": "§1.4, §3.2",
    "question": "Are data protection, access control, secrets handling, auditability and regulatory obligations covered for the data the design handles?",
    "research_hints": [
     "applicable data-protection regulation and official security guidance for the named services"
    ]
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "scalability_and_failure_modes",
    "kinds": [
     "risk",
     "validation_need"
    ],
    "lab_ref": "§1.4, §3.2",
    "question": "Does the design hold at the stated load and under partial failure, retry, concurrency and recovery?",
    "research_hints": [
     "published performance characteristics and failure behaviour of the named components"
    ]
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "assumptions_and_dependencies",
    "kinds": [
     "unresolved_assumption"
    ],
    "lab_ref": "§1.2, §2.3",
    "question": "Which premises, pending items, vendor capabilities or approvals does the design rely on without verifying or tracking them to closure?",
    "research_hints": []
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "verifiability",
    "kinds": [
     "validation_need"
    ],
    "lab_ref": "§2.3, §3.2",
    "question": "Can each requirement be verified by its acceptance criterion, and which claims need a test, benchmark or prototype?",
    "research_hints": [
     "recognised test or benchmark methods for the claim"
    ]
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "decision_preservation",
    "kinds": [
     "strength",
     "risk",
     "unresolved_assumption"
    ],
    "lab_ref": "§1.3",
    "question": "Do the design and any proposed refinement preserve the approved decisions and constraints, and is any challenge to one justified by strong evidence?",
    "research_hints": []
   },
   {
    "applies_to": [
     "all"
    ],
    "id": "operability_and_governance",
    "kinds": [
     "gap",
     "unresolved_assumption"
    ],
    "lab_ref": "§3.2",
    "question": "Are operation, monitoring, cost, ownership and the governance decisions the design needs identified, with an accountable owner?",
    "research_hints": []
   }
  ]
 },
