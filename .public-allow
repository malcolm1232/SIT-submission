# Accepted findings of scripts/export_public_snapshot.py, one RULE:GLOB per line with its reason.
# Reviewed on 2026-10-03 against commit ec1978e (values seen masked, as rule, length and distinct characters).
# This file is a private review record: the export leaves it out.

# sha256 digests (pure lower-case hex, 64 chars): config and code hashes in run manifests and reports,
# prompt locks, report provenance, the example review fixture, and digests quoted in docs and tests.
hex64:*  # sha256 content digests, not credentials

# PDF internals of the synthetic design documents: outline titles in UTF-16 hex, /ID pairs, DocChecksum.
hex32:eval/synthetic/*/design_v*.pdf  # PDF /ID and DocChecksum
token64:eval/synthetic/*/design_v*.pdf  # PDF outline titles in UTF-16 hex
hex32:tests/test_ingest_verify_report.py  # a fake PDF /ID in a test fixture string
hex32:research/methodology/README.md  # a NeurIPS proceedings URL path
hex32:research/models/judge-bias-evidence.md  # a NeurIPS proceedings URL path

# 64-character identifiers: test function names and test names quoted in edit logs.
token64:tests/test_adversarial_invariants.py  # a test name in the module docstring
token64:tests/test_budget_counts_failed_calls.py  # a test function name
token64:tests/test_call_log_run_fields.py  # a test function name
token64:tests/test_cli_replay.py  # test function names
token64:tests/test_fault_injection.py  # a test function name
token64:tests/test_interfaces_w0.py  # a test function name
token64:tests/test_manifest_concurrent.py  # a test function name
token64:tests/test_refine_next_step.py  # a test function name
token64:tests/test_runtime_policies.py  # test function names
token64:tests/test_tool_gateways.py  # a test function name
token64:tests/test_mcp_session_recovery.py  # a test function name (reviewed 2026-10-03, final hub)
token64:tests/test_ui_events.py  # a test function name (reviewed 2026-10-03, final hub)
token64:research/audit/latency_verifier_editlog.md  # a test name quoted in the edit log
token64:research/audit/verify_runtime_cli_editlog.md  # test names quoted in the edit log

# Fake credentials in redaction and environment tests (values such as sk-test-..., SECRET-VALUE).
sk-key:tests/eval_harness/test_eval_live_judges.py  # fake key set in the test environment
sk-key:tests/test_anthropic_gateway.py  # fake keys for the redaction test
sk-key:tests/test_claude_code_gateway.py  # fake key set in the test environment
sk-key:tests/test_tool_gateways.py  # fake key in the redaction test cases
api_key:tests/test_tool_gateways.py  # fake credential assignment in the redaction test cases
bearer:tests/test_state_and_gateways.py  # fake header value in the redactor test
bearer:tests/test_tool_gateways.py  # prose: "Bearer answered HTTP 200" in a docstring

# api_key= matches that are code or environment variable names, not values.
api_key:agent/sit_review_agent/llm/claude_code.py  # an attribute name (inherit_api_key...)
api_key:harness/sit_eval/live_judges.py  # an attribute name (inherit_api_key...)
api_key:agent/sit_review_agent/ui/chat.py  # an attribute name (inherit_api_key...), reviewed 2026-10-03, final hub
api_key:research/robustness/README.md  # environment variable names in prose
api_key:tests/robustness/README.md  # environment variable name in a command line
api_key:tests/robustness/robustness_coverage.py  # environment variable name in a command line

# The word oauth in code and prose (marker strings, an env var name, design discussion); no value.
oauth:agent/sit_review_agent/llm/claude_code.py  # an auth-error marker string
oauth:agent/sit_review_agent/llm/gateway.py  # the name of an environment variable the gateway strips
oauth:docs/DECISIONS.md  # design discussion of the MCP connector and subscription terms
oauth:docs/live_runs/*/MEASUREMENT.md  # the run's own secret-scan summary naming what it looked for
oauth:eval/synthetic/research_lakehouse/design_v1.md  # synthetic design text
oauth:research/audit/latency_w1_editlog.md  # a list of scan needles
oauth:research/frameworks/README.md  # framework comparison prose
oauth:research/frameworks/comparison.md  # framework comparison prose
oauth:scripts/leakage_grep.py  # a generic-word list entry
oauth:scripts/export_public_snapshot.py  # the scanner's own rule name and docstring
oauth:tests/test_claude_code_gateway.py  # an error message in a test case

# The MCP session id header named in a comment, no value.
mcp-session-id:agent/sit_review_agent/tools/gateway.py  # a comment naming the header

# Fictional e-mail in a synthetic design document (a made-up university domain).
email:eval/synthetic/research_lakehouse/design_v*.md  # an example user principal name in a table

# The account name and home path of the machine the work was done on, in worktree paths.
# FOR THE OWNER: accept, or ask for these files to be redacted or dropped before publishing.

# Reserved example domains (example.com/org/net, .test, .invalid) in fixtures and tests.
email-example:*  # reserved example domains, never real addresses
