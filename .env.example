# Copy to .env (git ignores it), fill in the values, and load it into the shell before running:
#   set -a; . ./.env; set +a
# The agent reads the environment, never this file. Never commit a filled-in copy.

# The shared key of the four SIT MCP servers (lab brief section 2.2), sent as "Authorization: Bearer <key>".
# Needed for a review with tools on; a review with --no-tools runs without it.
SIT_MCP_API_KEY=

# Optional: the SMTP password for the Email action of `dra ui`. The server, user and sender are set in
# config/ui.yaml; with this unset the Email button is shown disabled with its reason.
SIT_UI_SMTP_PASSWORD=

# Not needed: the default backend (config/agent.yaml llm.backend: claude_code) uses the Claude Code login and
# strips ANTHROPIC_API_KEY from its environment. Only the alternative anthropic_api backend reads that key.
